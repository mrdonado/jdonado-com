---
import { cv } from '@/data/cv'
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<meta name='robots' content='noindex' />
		<title>{cv.name} – CV</title>
		<link rel='preload' href='/fonts/Raleway-Bold.ttf' as='font' type='font/ttf' crossorigin />
		<link rel='preload' href='/fonts/Raleway-Regular.ttf' as='font' type='font/ttf' crossorigin />
		<style>
			@font-face {
				font-family: 'Raleway';
				src: url('/fonts/Raleway-Regular.ttf') format('truetype');
				font-weight: 400;
				font-style: normal;
			}
			@font-face {
				font-family: 'Raleway';
				src: url('/fonts/Raleway-Bold.ttf') format('truetype');
				font-weight: 700;
				font-style: normal;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			:root {
				--color-text: #1c1917;
				--color-muted: #57534e;
				--color-subtle: #a8a29e;
				--color-border: #e7e5e4;
				--color-accent: #292524;
				--color-tag-bg: #f5f5f4;
				--font-sans: 'Raleway', ui-sans-serif, system-ui, sans-serif;
			}

			html,
			body {
				font-family: var(--font-sans);
				font-size: 9.5pt;
				color: var(--color-text);
				background: #fff;
				line-height: 1.45;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			/* ── Page layout ── */
			.page {
				width: 210mm;
				min-height: 297mm;
				margin: 0 auto;
				padding: 12mm 14mm;
			}

			@media screen {
				body {
					background: #e5e7eb;
					padding: 20px 0;
				}
				.page {
					background: #fff;
					box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
				}
			}

			@page {
				size: A4 portrait;
				margin: 12mm 14mm;
			}

			@media print {
				body,
				html {
					background: #fff;
				}
				.page {
					width: 100%;
					padding: 0;
					margin: 0;
					min-height: 0;
					box-shadow: none;
				}
				.print-hide {
					display: none !important;
				}
				/*
				 * display:table has the best cross-browser fragmentation support.
				 * Grid/float both cause Firefox (and sometimes Chrome) to push the
				 * entire body block to page 2. Table cells fragment naturally.
				 */
				.cv-body {
					display: table;
					width: 100%;
					table-layout: fixed;
					break-before: auto;
					page-break-before: auto;
					break-inside: auto;
					page-break-inside: auto;
				}
				.cv-sidebar {
					display: table-cell;
					width: 58mm;
					padding-right: 8mm;
					vertical-align: top;
					break-inside: auto;
					page-break-inside: auto;
				}
				.cv-main {
					display: table-cell;
					vertical-align: top;
					break-inside: auto;
					page-break-inside: auto;
				}
				/* Replicate the flex gap that is lost when display changes to table-cell */
				.cv-sidebar > section:not(:last-child),
				.cv-main > section:not(:last-child) {
					margin-bottom: 7mm;
				}
			}

			/* ── Header ── */
			.cv-header {
				margin-bottom: 10mm;
				padding-bottom: 6mm;
				border-bottom: 1.5px solid var(--color-accent);
			}

			.cv-name {
				font-size: 22pt;
				font-weight: 700;
				letter-spacing: -0.01em;
				line-height: 1.1;
				margin-bottom: 2mm;
			}

			.cv-title {
				font-size: 11pt;
				font-weight: 400;
				color: var(--color-muted);
				margin-bottom: 3mm;
			}

			.cv-contact {
				display: flex;
				flex-wrap: wrap;
				gap: 4mm 6mm;
				font-size: 7.5pt;
				color: var(--color-muted);
			}

			.cv-contact a {
				color: var(--color-muted);
				text-decoration: none;
			}

			/* ── Two-column body ── */
			.cv-body {
				display: grid;
				grid-template-columns: 58mm 1fr;
				gap: 8mm;
				align-items: start;
			}

			/* ── Sidebar ── */
			.cv-sidebar {
				display: flex;
				flex-direction: column;
				gap: 7mm;
			}

			/* ── Main content ── */
			.cv-main {
				display: flex;
				flex-direction: column;
				gap: 7mm;
			}

			/* ── Section headings ── */
			.section-heading {
				font-size: 6pt;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--color-subtle);
				border-bottom: 0.75px solid var(--color-border);
				padding-bottom: 1.5mm;
				margin-bottom: 3mm;
			}

			/* ── Company block ── */
			.company-name {
				font-size: 9pt;
				font-weight: 700;
				margin-bottom: 0.5mm;
			}

			.company-meta {
				font-size: 7pt;
				color: var(--color-muted);
				margin-bottom: 2.5mm;
			}

			/* ── Position block ── */
			.position {
				margin-bottom: 3.5mm;
				padding-left: 3mm;
				border-left: 1.5px solid var(--color-border);
			}

			.position:last-child {
				margin-bottom: 0;
			}

			.position-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 3mm;
				margin-bottom: 1mm;
			}

			.position-title {
				font-size: 8.5pt;
				font-weight: 700;
				flex: 1;
			}

			.position-period {
				font-size: 7pt;
				color: var(--color-muted);
				white-space: nowrap;
			}

			.position-desc {
				font-size: 7.5pt;
				color: var(--color-muted);
				margin-bottom: 1.5mm;
				line-height: 1.4;
			}

			.responsibilities {
				list-style: none;
				margin-bottom: 1.5mm;
			}

			.responsibilities li {
				display: flex;
				gap: 2mm;
				font-size: 7.5pt;
				line-height: 1.4;
				margin-bottom: 0.8mm;
				color: var(--color-text);
			}

			.responsibilities li::before {
				content: '·';
				color: var(--color-subtle);
				font-weight: 700;
				flex-shrink: 0;
			}

			/* ── Tech tags ── */
			.tech-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 1mm;
				margin-top: 1.5mm;
			}

			.tech-tag {
				font-size: 6.5pt;
				padding: 0.5mm 2mm;
				background: var(--color-tag-bg);
				color: var(--color-muted);
				border-radius: 2mm;
			}

			/* ── Sidebar items ── */
			.sidebar-item {
				font-size: 7.5pt;
				line-height: 1.45;
			}

			.sidebar-item .label {
				display: block;
				font-size: 6pt;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--color-subtle);
				margin-bottom: 1mm;
			}

			.competency-item {
				margin-bottom: 2mm;
				page-break-inside: avoid;
			}

			.competency-cat {
				font-size: 7pt;
				font-weight: 700;
				color: var(--color-accent);
				margin-bottom: 0.5mm;
			}

			.competency-items {
				font-size: 7pt;
				color: var(--color-muted);
				line-height: 1.35;
			}

			/* ── Language table ── */
			.lang-row {
				display: flex;
				justify-content: space-between;
				font-size: 7.5pt;
				padding: 0.8mm 0;
				border-bottom: 0.5px solid var(--color-border);
			}

			.lang-row:last-child {
				border-bottom: none;
			}

			.lang-level {
				color: var(--color-muted);
				font-weight: 700;
			}

			/* ── Cert item ── */
			.cert-item {
				font-size: 7pt;
				margin-bottom: 1.5mm;
				line-height: 1.4;
			}

			.cert-year {
				color: var(--color-subtle);
				margin-right: 1.5mm;
			}

			/* ── Earlier experience (condensed) ── */
			.earlier-item {
				margin-bottom: 2.5mm;
				padding-left: 3mm;
				border-left: 1.5px solid var(--color-border);
				page-break-inside: avoid;
			}

			.earlier-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 2mm;
				margin-bottom: 0.5mm;
			}

			.earlier-name {
				font-size: 8pt;
				font-weight: 700;
			}

			.earlier-period {
				font-size: 7pt;
				color: var(--color-muted);
				white-space: nowrap;
			}

			.earlier-role {
				font-size: 7.5pt;
				color: var(--color-muted);
				margin-bottom: 1mm;
			}

			/* ── Education ── */
			.edu-block {
				padding-left: 3mm;
				border-left: 1.5px solid var(--color-border);
				page-break-inside: avoid;
			}

			.edu-institution {
				font-size: 8.5pt;
				font-weight: 700;
				margin-bottom: 0.5mm;
			}

			.edu-meta {
				font-size: 7pt;
				color: var(--color-muted);
				margin-bottom: 1mm;
			}

			.edu-degree {
				font-size: 8pt;
				font-weight: 700;
				margin-bottom: 0.5mm;
			}

			.edu-type {
				font-size: 7pt;
				color: var(--color-muted);
				margin-bottom: 1mm;
			}

			.edu-desc {
				font-size: 7.5pt;
				color: var(--color-muted);
				line-height: 1.4;
				margin-bottom: 1mm;
			}

			.edu-thesis {
				font-size: 7.5pt;
				margin-top: 1mm;
			}

			.edu-thesis strong {
				font-weight: 700;
			}

			/* ── Print button (screen only) ── */
			.print-btn {
				display: none;
			}

			.print-btn button {
				font-family: var(--font-sans);
				font-size: 9pt;
				padding: 6px 16px;
				background: var(--color-accent);
				color: #fff;
				border: none;
				border-radius: 4px;
				cursor: pointer;
			}

			@media screen {
				.print-btn {
					display: block;
					position: fixed;
					top: 12px;
					right: 12px;
					z-index: 100;
				}
			}
		</style>
	</head>
	<body>
		<!-- Print / Back buttons (screen only) -->
		<div class='print-btn print-hide'>
			<button onclick='window.print()'>Print / Save as PDF</button>
		</div>

		<div class='page'>
			<!-- ── Header ── -->
			<header class='cv-header'>
				<div class='cv-name'>{cv.name}</div>
				<div class='cv-title'>{cv.title}</div>
				<div class='cv-contact'>
					<span>{cv.location}</span>
					<span>{cv.citizenship}</span>
					<a href={`mailto:${cv.email}`}>{cv.email}</a>
					<a href={cv.website}>{cv.website}</a>
					<a href={cv.github}>{cv.github}</a>
				</div>
			</header>

			<!-- ── Body ── -->
			<div class='cv-body'>
				<!-- ═══ SIDEBAR ═══ -->
				<aside class='cv-sidebar'>
					<!-- Professional Summary -->
					<section>
						<div class='section-heading'>Summary</div>
						<p class='sidebar-item' style='font-size:7.5pt;line-height:1.45;color:#44403c;'>
							{cv.summary}
						</p>
					</section>

					<!-- Core Competencies -->
					<section>
						<div class='section-heading'>Core Competencies</div>
						{
							cv.competencies.map((comp) => (
								<div class='competency-item'>
									<div class='competency-cat'>{comp.category}</div>
									<div class='competency-items'>{comp.items}</div>
								</div>
							))
						}
					</section>

					<!-- Languages -->
					<section>
						<div class='section-heading'>Languages</div>
						{
							cv.languages.map((lang) => (
								<div class='lang-row'>
									<span>{lang.name}</span>
									<span class='lang-level'>{lang.isNative ? 'Native' : lang.level}</span>
								</div>
							))
						}
					</section>

					<!-- Certifications -->
					<section>
						<div class='section-heading'>Certifications &amp; Training</div>
						{
							cv.certifications.map((cert) => (
								<div class='cert-item'>
									<span class='cert-year'>{cert.year}</span> <span>{cert.name}</span>
									{cert.location && <span style='color:#a8a29e;'>, {cert.location}</span>}
								</div>
							))
						}
					</section>

					<!-- Additional Info -->
					<section>
						<div class='section-heading'>Additional</div>
						<div class='sidebar-item'>
							<span class='label'>Driving License</span>
							{cv.additionalInfo.drivingLicense}
						</div>
						<div class='sidebar-item' style='margin-top:2mm;'>
							<span class='label'>Interests</span>
							{cv.additionalInfo.interests}
						</div>
					</section>
				</aside>

				<!-- ═══ MAIN CONTENT ═══ -->
				<main class='cv-main'>
					<!-- Selected Impact -->
					<section>
						<div class='section-heading'>Selected Impact</div>
						<ul class='responsibilities'>
							{cv.impact.map((item) => <li>{item}</li>)}
						</ul>
					</section>

					<!-- Professional Experience -->
					<section>
						<div class='section-heading'>Professional Experience</div>

						{
							cv.experience.map((company) => (
								<div style='margin-bottom:4mm;'>
									<div class='company-name'>{company.name}</div>
									<div class='company-meta'>
										{company.location} · {company.period}
									</div>
									{company.positions.map((pos) => (
										<div class='position'>
											<div class='position-header'>
												<span class='position-title'>{pos.title}</span>
												<span class='position-period'>{pos.period}</span>
											</div>
											<p class='position-desc'>{pos.description}</p>
											<ul class='responsibilities'>
												{pos.responsibilities.map((r) => (
													<li>{r}</li>
												))}
											</ul>
											{pos.tags && (
												<div class='tech-tags'>
													{pos.tags.map((tech) => (
														<span class='tech-tag'>{tech}</span>
													))}
												</div>
											)}
										</div>
									))}
								</div>
							))
						}
					</section>

					<!-- Earlier Experience -->
					<section>
						<div class='section-heading'>Earlier Experience</div>
						{
							cv.earlierExperience.map((company) => (
								<div class='earlier-item'>
									<div class='earlier-header'>
										<span class='earlier-name'>{company.name}</span>
										<span class='earlier-period'>
											{company.location} · {company.period}
										</span>
									</div>
									{company.positions.map((pos) => (
										<div>
											<div class='earlier-role'>{pos.title}</div>
											<ul class='responsibilities'>
												{pos.responsibilities.map((r) => (
													<li>{r}</li>
												))}
											</ul>
											{pos.tags && (
												<div class='tech-tags'>
													{pos.tags.map((tech) => (
														<span class='tech-tag'>{tech}</span>
													))}
												</div>
											)}
										</div>
									))}
								</div>
							))
						}
					</section>

					<!-- Education -->
					<section>
						<div class='section-heading'>Education</div>
						{
							cv.education.map((edu) => (
								<div class='edu-block'>
									<div class='edu-institution'>{edu.institution}</div>
									<div class='edu-meta'>
										{edu.location} · {edu.year}
									</div>
									<div class='edu-degree'>{edu.degree}</div>
									<div class='edu-type'>{edu.degreeType}</div>
									<p class='edu-desc'>{edu.description}</p>
									{edu.thesis && (
										<div class='edu-thesis'>
											<strong>Thesis:</strong> {edu.thesis}
											{edu.grade && <span style='color:#a8a29e;'> · {edu.grade}</span>}
										</div>
									)}
									{edu.tags && (
										<div class='tech-tags' style='margin-top:1.5mm;'>
											{edu.tags.map((tech) => (
												<span class='tech-tag'>{tech}</span>
											))}
										</div>
									)}
								</div>
							))
						}
					</section>
				</main>
			</div>
		</div>
	</body>
</html>
