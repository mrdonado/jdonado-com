---
import BaseLayout from '@/layouts/BaseLayout'
import TitlePage from '@/components/TitlePage'
import ListCategories from '@/components/ListCategories'
import MinimalList from '@/components/MinimalList'
import { getApps, getPosts } from '@/utils'

const posts = await getPosts()
const apps = await getApps()
const allPosts = [...posts, ...apps].sort(
	(a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
)
const archiveYears = allPosts.map((post) => new Date(post.data.pubDate).getFullYear())
const newestYear = Math.max(...archiveYears)
const oldestYear = Math.min(...archiveYears)
const postsByYear = allPosts.reduce(
	(groups, post) => {
		const year = new Date(post.data.pubDate).getFullYear()
		groups[year] = [...(groups[year] || []), post]
		return groups
	},
	{} as Record<number, typeof allPosts>
)
const archiveGroups = Object.entries(postsByYear)
	.map(([year, items]) => ({ year: Number(year), items }))
	.sort((a, b) => b.year - a.year)
---

<BaseLayout title='Archive'>
	<TitlePage title='Archive' />
	<ListCategories />
	<section class='mt-8 overflow-hidden border border-stone-300 shadow-[6px_6px_0_rgba(0,0,0,0.08)] dark:border-stone-700 dark:shadow-[6px_6px_0_rgba(255,255,255,0.05)]'>
		<header class='border-b border-stone-300 px-4 py-3 dark:border-stone-700 md:px-6'>
			<div class='flex items-end justify-between gap-4 font-mono text-xs uppercase tracking-[0.24em] text-stone-700 dark:text-stone-300'>
				<span>Time Cabinet</span>
				<span>{oldestYear}-{newestYear}</span>
			</div>
		</header>
		<div class='px-4 py-4 md:px-6 md:py-5'>
			{
				archiveGroups.map((group, groupIndex) => {
					const animationOffset = archiveGroups
						.slice(0, groupIndex)
						.reduce((total, previousGroup) => total + previousGroup.items.length, 0)

					return (
						<section class='mb-7 last:mb-0'>
							<div class='mb-3 flex items-center gap-4'>
								<h2 class='font-mono text-sm font-normal tracking-[0.2em] text-stone-500 dark:text-stone-400'>
									{group.year}
								</h2>
								<span class='flex flex-1 flex-col gap-1'>
									<span class='h-px bg-stone-400 dark:bg-stone-500'></span>
									<span class='h-px bg-stone-400/80 dark:bg-stone-500/80'></span>
								</span>
							</div>
							<MinimalList
								items={group.items}
								showThumbnail
								drawerAnimation
								animationOffset={animationOffset}
							/>
						</section>
					)
				})
			}
		</div>
	</section>
</BaseLayout>
