{
	"name": "jdonado-com",
	"type": "module",
	"version": "1.1.0",
	"description": "Jdonado's website",
	"author": "mrdonado",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/mrdonado/jdonado-com"
	},
	"keywords": [
		"astro",
		"astrojs"
	],
	"scripts": {
		"dev": "astro dev --host",
		"dev:portless": "pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"dev:portless:http": "pnpm exec portless proxy stop; pnpm exec portless proxy start --no-tls && pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"start": "astro dev",
		"build": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "eslint .",
		"pre-commit": "lint-staged",
		"generate-cv": "node scripts/generate-cv-pdf.mjs",
		"generate-cover": "node scripts/generate-cover-image.mjs",
		"generate-cover-simple": "node scripts/generate-youtube-simple-cover-image.mjs",
		"generate-podcast-video": "node scripts/generate-podcast-video.mjs",
		"build-podcast": "node scripts/build-podcast-video.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.9",
		"@astrojs/rss": "4.0.19",
		"astro": "7.4.12",
		"astro-font": "^1.2.0",
		"astro-imagetools": "^0.9.0",
		"rehype-raw": "^7.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "0.35.5",
		"tailwindcss": "^4.3.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/mdx": "8.1.6",
		"@astrojs/sitemap": "3.7.6",
		"@emnapi/runtime": "1.11.3",
		"@pagefind/default-ui": "1.6.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@typescript-eslint/parser": "^8.73.0",
		"clsx": "2.1.1",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^3.2.1",
		"lint-staged": "^17.6.1",
		"mdast-util-to-string": "^4.0.0",
		"pagefind": "1.5.2",
		"portless": "^0.18.0",
		"prettier": "^3.10.1",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^1.1.2",
		"puppeteer": "^25.18.1",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "3.7.0",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	}
}
