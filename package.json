{
	"name": "jdonado-com",
	"type": "module",
	"version": "1.1.0",
	"description": "Jdonado's website",
	"author": "mrdonado",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/mrdonado/jdonado-com"
	},
	"keywords": [
		"astro",
		"astrojs"
	],
	"scripts": {
		"dev": "astro dev --host",
		"dev:portless": "pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"dev:portless:http": "pnpm exec portless proxy stop; pnpm exec portless proxy start --no-tls && pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"start": "astro dev",
		"build": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --plugin-search-dir=. --check .",
		"format": "prettier --plugin-search-dir=. --write .",
		"lint": "eslint .",
		"pre-commit": "lint-staged",
		"generate-cv": "node scripts/generate-cv-pdf.mjs",
		"generate-cover": "node scripts/generate-cover-image.mjs",
		"generate-cover-simple": "node scripts/generate-youtube-simple-cover-image.mjs",
		"generate-podcast-video": "node scripts/generate-podcast-video.mjs",
		"build-podcast": "node scripts/build-podcast-video.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.6",
		"@astrojs/rss": "4.0.19",
		"astro": "7.4.7",
		"astro-font": "^1.2.0",
		"astro-imagetools": "^0.9.0",
		"rehype-raw": "^7.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "0.35.5",
		"tailwindcss": "^4.3.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/mdx": "8.1.3",
		"@astrojs/sitemap": "3.7.4",
		"@pagefind/default-ui": "1.5.2",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@typescript-eslint/parser": "^8.72.1",
		"clsx": "2.1.1",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.2.1",
		"lint-staged": "^17.6.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^14.9.1",
		"pagefind": "1.5.2",
		"portless": "^0.15.13",
		"prettier": "^3.9.10",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^1.1.2",
		"puppeteer": "^25.16.0",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "3.7.0",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	},
	"pnpm": {
		"overrides": {
			"astro-imagetools>file-type": "^21.3.1",
			"imagetools-core>sharp": "0.35.5",
			"@jimp/core>phin": "^3.7.1",
			"@tailwindcss/typography>postcss-selector-parser": "^6.1.5",
			"minimatch@>=7 <11": "^11.0.1"
		},
		"supportedArchitectures": {
			"libc": [
				"musl",
				"glibc"
			]
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		],
		"patchedDependencies": {
			"astro-imagetools@0.9.0": "patches/astro-imagetools@0.9.0.patch"
		}
	}
}
