{
	"name": "jdonado-com",
	"type": "module",
	"version": "1.1.0",
	"description": "Jdonado's website",
	"author": "mrdonado",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/mrdonado/jdonado-com"
	},
	"keywords": [
		"astro",
		"astrojs"
	],
	"scripts": {
		"dev": "astro dev --host",
		"dev:portless": "pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"dev:portless:http": "pnpm exec portless proxy stop; pnpm exec portless proxy start --no-tls && pnpm exec portless jdonado-com --force -- sh -c 'pnpm exec astro dev --host \"$HOST\" --port \"$PORT\"'",
		"start": "astro dev",
		"build": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --plugin-search-dir=. --check .",
		"format": "prettier --plugin-search-dir=. --write .",
		"lint": "eslint .",
		"pre-commit": "lint-staged",
		"generate-cv": "node scripts/generate-cv-pdf.mjs",
		"generate-cover": "node scripts/generate-cover-image.mjs",
		"generate-cover-simple": "node scripts/generate-youtube-simple-cover-image.mjs",
		"generate-podcast-video": "node scripts/generate-podcast-video.mjs",
		"build-podcast": "node scripts/build-podcast-video.mjs"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.18",
		"@astropub/md": "^1.0.0",
		"astro": "6.3.7",
		"astro-font": "^1.1.0",
		"astro-imagetools": "^0.9.0",
		"rehype-raw": "^7.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "0.34.5",
		"tailwindcss": "^4.3.0",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/mdx": "5.0.6",
		"@astrojs/sitemap": "3.7.2",
		"@pagefind/default-ui": "^1.5.2",
		"@tailwindcss/typography": "0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@typescript-eslint/parser": "^8.59.4",
		"clsx": "2.1.1",
		"eslint": "^9.39.4",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"lint-staged": "^16.4.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^12.40.0",
		"pagefind": "^1.5.2",
		"portless": "^0.14.0",
		"prettier": "^3.8.3",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^0.14.1",
		"puppeteer": "^24.43.1",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "3.5.0",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	},
	"pnpm": {
		"overrides": {
			"vite": "^7",
			"mermaid": "10.9.3",
			"sharp": "0.34.5",
			"imagetools-core>sharp": "0.34.5",
			"file-type": "^17.1.3",
			"phin": "3.7.1",
			"follow-redirects": ">=1.16.0",
			"yaml": ">=2.8.3"
		},
		"supportedArchitectures": {
			"libc": [
				"musl",
				"glibc"
			]
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		],
		"patchedDependencies": {
			"astro-imagetools@0.9.0": "patches/astro-imagetools@0.9.0.patch",
			"portless@0.14.0": "patches/portless@0.14.0.patch"
		}
	}
}
